---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Sobre mí";

const identity = {
  firstName: "Donovan",
  country: "México",
  occupation: "Estudiante de Desarrollo de Software",
  hobbies: ["Cocinar", "Ver series", "Salir con amigos", "Jugar videojuegos"],
};

const skills = ["HTML", "CSS", "JavaScript", "Astro", "Preact", "C++", "Python"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "navy";
const fontWeight = "bold";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>
  <style is:global define:vars={{skillColor, fontWeight, textCase}}>
    h1 {
      color: #ff4d6d;
      font-size: 2.5rem;
    }
    .skill {
      color: var(--skillColor);
      font-weight: var(--fontWeight);
      text-transform: var(--textCase);
    }
  </style>

  <h2>... ¡y mi nuevo sitio en Astro!</h2>

  <p>Estoy trabajando en el tutorial introductorio de Astro. Esta es la segunda página de mi sitio web</p>

  <p>Este sitio es acerca de algunos de mis personajes favoritos del anime One Piece el cual recomiendo completamente verlo, anque esta largo tiene un encanto que no todo anime tiene</p>

  <p>He aquí algunos datos sobre mí:</p>
  <ul>
    <li>Mi nombre es {identity.firstName}.</li>
    <li>Vivo en {identity.country} y soy {identity.occupation}.</li>
    {identity.hobbies.length >= 2 &&
      <li>Dos de mis pasatiempos son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
    }
  </ul>
  <p>Algunas habilidades que e adquirido en programacion son:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  {happy && <p>Estoy feliz de estar aprendiendo Astro</p>}

  {finished && <p>Y compartir un gusto que tengo</p>}
</BaseLayout>