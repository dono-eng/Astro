---
import BaseLayout from '../layouts/BaseLayout.astro';

// Añadimos url: string junto con frontmatter al tipo
const postsMap = import.meta.glob<{ url: string; frontmatter: { title: string } }>('./posts/*.md', { eager: true });
const allPosts = Object.values(postsMap);

const pageTitle = "My Astro Learning Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <p>This is where I will post about my journey learning Astro.</p>
  <ul>
    {allPosts.map((post) => (
      <li><a href={post.url}>{post.frontmatter.title}</a></li>
    ))}
  </ul>
</BaseLayout>